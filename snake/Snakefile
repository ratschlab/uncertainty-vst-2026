        "  --config snake/config/config.yaml "
        "  --dataset {wildcards.dataset} "
        "  --dev-gene-set-id {params.dev_gene_set_id} "
        "  --gene-emb-id {params.gene_emb_id} "
        "  --chrom-split-spec {params.chrom_split_spec} "
        "  --use-projection {params.use_projection} "
        "  --permute-embeddings {params.permute_embeddings} "
        "  --radius {params.radius_val} "
        "  --model-type {wildcards.model_type} "
        "  --lam {wildcards.lam} "
        "  --preprocessed-dir {params.preproc_dir} "
        "  --output-dir {params.out_dir} "
        # RC re-raises the TRAINING exit code at the end, so a crash is not masked by
        # gpu_summarize. The kill + summary still run on failure (see tee note at the top).
        "  2>&1 | tee {log}; RC=$?; "
        "kill $NVSMI_PID 2>/dev/null; "
        "python snake/scripts/gpu_summarize.py $GPU_RAW $GPU_SUM --skip-seconds 20; "
        "exit $RC"


# ------------------------------------------------------------------------------
# GCM deep-ensemble member, the GCM analog of train_ensemble_member.
#
# It follows train_gcm_gaussian with three differences: the path segment is /seed_{seed}/
# instead of /lambda_{lam}/, --lam is the constant ENSEMBLE_LAMBDA, and --seed is passed.
# The training loop seeds fold k with seed+fold, so a member seed varies initialization and
# batch shuffling while the splits stay fixed. Scope is ENS_GCM_MODELS over the runs in
# GCM_ENSEMBLE_RUNS; one rule covers every model kind in that list, because the loss
# receives lam only when the spec's uses_lam is True.
# ------------------------------------------------------------------------------
rule train_gcm_ensemble_member:
    input:
        adata = f"results/{{dataset}}/_preprocessed/{PREPROC_ID}/{{radius}}/adata.h5ad",
    output:
        metrics = "results_gcm/{dataset}/{run_id}/{radius}/{model_type}/seed_{seed}/metrics.json",
        model   = "results_gcm/{dataset}/{run_id}/{radius}/{model_type}/seed_{seed}/model.pt",
    params:
        dev_gene_set_id    = lambda wc: _gcm_params(wc)["dev_gene_set_id"],
        gene_emb_id        = lambda wc: _gcm_params(wc)["gene_emb_id"],
        chrom_split_spec   = lambda wc: _gcm_params(wc)["chrom_spec"],
        use_projection     = lambda wc: _gcm_params(wc)["use_projection"],
        permute_embeddings = lambda wc: _gcm_params(wc)["permute_embeddings"],
        preproc_dir        = f"results/{{dataset}}/_preprocessed/{PREPROC_ID}/{{radius}}",
        out_dir            = "results_gcm/{dataset}/{run_id}/{radius}/{model_type}/seed_{seed}",
        radius_val         = lambda wc: _r_value(wc.radius),
        lam                = ENSEMBLE_LAMBDA,
    wildcard_constraints:
        run_id     = _gcm_run_id_constraint,
        model_type = _ens_gcm_model_constraint,
        seed       = r"\d+",
    resources:
        time      = get_gcm_train_time,
        cpus      = 5,
        mem_mb    = get_gcm_train_mem,
        gpus      = 1,
        partition = "gpu",
    log:
        "results_gcm/{dataset}/{run_id}/{radius}/{model_type}/seed_{seed}/logs/train_gcm.log"
    shell:
        "LOGDIR=$(dirname {log}); "
        "GPU_RAW=$LOGDIR/gpu_raw.csv; GPU_SUM=$LOGDIR/gpu_summary.txt; "
        "nvidia-smi --query-gpu=timestamp,index,utilization.gpu,utilization.memory,memory.used,memory.total "
        "  --format=csv -l 1 > $GPU_RAW & "
        "NVSMI_PID=$!; trap 'kill $NVSMI_PID 2>/dev/null' EXIT; "
        "python -u snake/scripts/train_gcm.py "
        "  --config snake/config/config.yaml "
        "  --dataset {wildcards.dataset} "
        "  --dev-gene-set-id {params.dev_gene_set_id} "
        "  --gene-emb-id {params.gene_emb_id} "
        "  --chrom-split-spec {params.chrom_split_spec} "
        "  --use-projection {params.use_projection} "
        "  --permute-embeddings {params.permute_embeddings} "
        "  --radius {params.radius_val} "
        "  --model-type {wildcards.model_type} "
        "  --lam {params.lam} "
        "  --seed {wildcards.seed} "
        "  --preprocessed-dir {params.preproc_dir} "
        "  --output-dir {params.out_dir} "
        # RC re-raises the TRAINING exit code at the end, so a crash is not masked by
        # gpu_summarize. The kill + summary still run on failure (see tee note at the top).
        "  2>&1 | tee {log}; RC=$?; "
        "kill $NVSMI_PID 2>/dev/null; "
        "python snake/scripts/gpu_summarize.py $GPU_RAW $GPU_SUM --skip-seconds 20; "
        "exit $RC"


# GCM deep-ensemble combine, the GCM analog of combine_ensemble_classic. It fans in the
# ENSEMBLE_SEEDS members of one (run_id, radius, model_type) into a single
# test_summaries.h5ad, using the same script, which reads the model family off
# metrics.json. Requested by all_ensemble_combine and all_ensemble_combine_gcm, never by
# all_train_ensemble, so a members launch does not drag it in. Pure read plus numpy, so no GPU
# monitor.
#
# There is no GCM g* rule, so this has no g* input, unlike combine_ensemble_classic. A
# count model ensembled here gets a test_summaries.h5ad with no gstar, pit or zero_prob
# layers: the combine writes those only when it finds gstar_fold*.h5ad beside the member
# predictions.
rule combine_ensemble_gcm:
    input:
        members = lambda wc: expand(
            "results_gcm/{dataset}/{run_id}/{radius}/{model_type}/seed_{seed}/metrics.json",
            dataset=[wc.dataset], run_id=[wc.run_id], radius=[wc.radius],
            model_type=[wc.model_type], seed=ENSEMBLE_SEEDS),
    output:
        summary = "results_gcm/{dataset}/{run_id}/{radius}/{model_type}/ensemble/test_summaries.h5ad",
    params:
        model_dir = "results_gcm/{dataset}/{run_id}/{radius}/{model_type}",
        seeds     = ENSEMBLE_SEEDS_CSV,
    wildcard_constraints:
        run_id     = _gcm_run_id_constraint,
        model_type = _ens_gcm_model_constraint,
    resources:
        # CPU-only: gpus=0 with partition=compute lands the job on a CPU node. GCM
        # predictions are large, so the budget is deliberately generous.
        time = "02:00:00", cpus = 2, mem_mb = 128000, gpus = 0, partition = "compute",
    shell:
        # NO redirect: timing prints flow to the SLURM job stdout ->
        # snake/logs/slurm_combine_ensemble_gcm_<jobid>.out (find it by job id).
        "python -u snake/scripts/epistemic/deep_ensemble_combine.py "
        "  --model-dir {params.model_dir} --seeds {params.seeds}"
